{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tuxhub",
  "version": "0.6.0",
  "identifier": "io.github.sirsnolte.tuxhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "tuxhub",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: tool:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:* data:",
        "frame-src": "'self' tool: toolweb: http://127.0.0.1:* http://localhost:* https:",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "Modular hub for gaming on Linux",
    "createUpdaterArtifacts": true,
    "publisher": "SirSnolte",
    "homepage": "https://github.com/SirSnolte/tuxhub",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 SirSnolte",
    "longDescription": "tuxhub installs, updates and launches gaming tools for Linux from a curated workshop. Tools can run in their own window or inside tuxhub."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NzVDODAyMEUzQkIwRDIKUldUU3NEc09Bc2gxK1hlL3l4NDNxczhvUWNUaXo1NitjTkczN2JYZG0wMjh2L2w3Q1dib1BVTEUK",
      "endpoints": [
        "https://github.com/SirSnolte/tuxhub/releases/latest/download/latest.json"
      ]
    }
  }
}
